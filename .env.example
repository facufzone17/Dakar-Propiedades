# Supabase — proyecto "dakar-propiedades"
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# Necesaria para que el panel pueda GUARDAR (alta/edición/baja y subida de
# fotos). La RLS solo deja escribir a este rol; el panel la usa únicamente en el
# servidor y detrás del login. Sin ella el panel abre en modo lectura.
# Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Acceso al panel (/admin). Si no se cargan, valen los defaults del código
# (ver src/lib/panel-auth.ts).
PANEL_USUARIO=dakarpropiedades
PANEL_PASSWORD=<contraseña del panel>
# Clave con la que se firma el cookie de sesión. Cambiarla cierra todas las
# sesiones abiertas. Poner algo largo y al azar antes de entregar el sitio.
PANEL_SECRET=<cadena larga al azar>
