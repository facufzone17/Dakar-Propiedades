# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>

# Necesaria para que el panel pueda GUARDAR (alta/edición/baja y subida de
# fotos). La RLS solo deja escribir a este rol; el panel la usa únicamente en el
# servidor y detrás del login. Sin ella el panel abre en modo lectura.
# Supabase -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# Acceso al panel (/admin). Si no se cargan, valen los defaults del código
# (ver src/lib/panel-auth.ts: admin / demo1234).
PANEL_USUARIO=admin
PANEL_PASSWORD=<contraseña del panel>
# Clave con la que se firma el cookie de sesión. Cambiarla cierra todas las
# sesiones abiertas. Poner algo largo y al azar por cada cliente.
PANEL_SECRET=<cadena larga al azar>

# --- Branding del cliente (opcional; ver src/config/site.ts para los defaults) ---
NEXT_PUBLIC_SITIO_NOMBRE=Distrito Propiedades
NEXT_PUBLIC_SITIO_NOMBRE_CORTO=Distrito
NEXT_PUBLIC_SITIO_DIRECCION=Av. Rivadavia 15000
NEXT_PUBLIC_SITIO_LOCALIDAD=Ramos Mejía, Buenos Aires
NEXT_PUBLIC_SITIO_TELEFONO=11 3025-6777
NEXT_PUBLIC_SITIO_TELEFONO_HREF=tel:+541130256777
NEXT_PUBLIC_SITIO_EMAIL=tu-inmobiliaria@ejemplo.com
NEXT_PUBLIC_SITIO_HORARIO=9 a 13 h y 15 a 19 h
NEXT_PUBLIC_SITIO_ZONA_FRASE=Inmobiliaria en la zona oeste
NEXT_PUBLIC_SITIO_MATRICULA=
# Formato wa.me: 54 + 9 + característica sin 0 + número sin 15
NEXT_PUBLIC_WHATSAPP_NUMERO=5491130256777
